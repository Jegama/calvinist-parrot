// prisma/schema.prisma

// Always use  `npx prisma migrate dev` to apply changes to the dev database
// To see the tables locally, use `npx prisma studio`
// For production, use `npx prisma migrate deploy` after deploying new code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model questionHistory {
  id              String   @id @default(cuid())
  question        String
  category        String
  subcategory     String
  issue_type      String
  reviewed_answer String
  userId          String?
  createdAt       DateTime @default(now())
  denomination    String   @default("reformed-baptist")
}

model userProfile {
  id                         String             @id @default(cuid())
  appwriteUserId             String             @unique
  displayName                String
  email                      String?
  defaultSpaceId             String?
  answeredPersonalCount      Int                @default(0)
  answeredFamilyCount        Int                @default(0)
  journalEntriesCount        Int                @default(0)
  lastPrayerAt               DateTime?
  lastSeenAt                 DateTime           @default(now())
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  
  // Theological Preferences & Learning
  denomination               String?            @default("reformed-baptist")
  preferredDepth             String?            @default("concise") // "concise" | "moderate" | "detailed"
  followUpTendency           String?            // "deep_diver" | "quick_mover" | "balanced" | null
  
  // Spiritual Journey Tracking (PRIVATE - never reveal to user)
  spiritualStatus            String?            // "seeker" | "new_believer" | "mature_believer" | "unclear"
  gospelPresentedAt          DateTime?          // Last time Gospel was clearly presented
  gospelPresentationCount    Int                @default(0)
  
  // Doctrinal Question Tracking
  coreDoctrineQuestions      Int                @default(0)
  secondaryDoctrineQuestions Int                @default(0)
  tertiaryDoctrineQuestions  Int                @default(0)
  
  // Ministry & Life Context
  ministryContext            String[]           // ["parent", "pastor", "teacher", "student", etc.]
  churchInvolvement          String?            // "active_member" | "seeking_church" | "unclear"
  
  defaultSpace               prayerFamilySpace? @relation("DefaultSpaceProfiles", fields: [defaultSpaceId], references: [id])
}

model prayerFamilySpace {
  id               String                  @id @default(cuid())
  spaceName        String
  shareCode        String                  @unique
  createdByUserId  String
  archivedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  families         prayerFamily[]
  journal          prayerJournalEntry[]
  journalEntries   journalEntry[]          // Journal v1 entries
  members          prayerMember[]
  personalRequests prayerPersonalRequest[]
  profiles         userProfile[]           @relation("DefaultSpaceProfiles")
}

model prayerMember {
  id                 String            @id @default(cuid())
  spaceId            String
  appwriteUserId     String?
  displayName        String
  role               MemberRole        @default(MEMBER)
  isChild            Boolean           @default(false)
  birthdate          DateTime?         // For age calculation (Kids Discipleship, bracket badges)
  assignmentCapacity Int               @default(2)
  assignmentCount    Int               @default(0)
  joinedAt           DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastPrayed         prayerFamily[]    @relation("LastPrayedBy")
  space              prayerFamilySpace @relation(fields: [spaceId], references: [id])

  // Kids Discipleship relations (Phase 3)
  annualPlans        discipleshipAnnualPlan[]    @relation("ChildAnnualPlans")
  monthlyVisions     discipleshipMonthlyVision[] @relation("ChildMonthlyVisions")

  @@index([spaceId])
}

model prayerFamily {
  id                   String                @id @default(cuid())
  spaceId              String
  familyName           String
  parents              String
  children             String[]
  categoryTag          String?
  lastPrayedAt         DateTime?
  lastPrayedByMemberId String?
  journalNotes         String?
  linkedScripture      String?
  archivedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  lastPrayedBy         prayerMember?         @relation("LastPrayedBy", fields: [lastPrayedByMemberId], references: [id])
  space                prayerFamilySpace     @relation(fields: [spaceId], references: [id])
  requests             prayerFamilyRequest[]

  @@index([spaceId])
}

model prayerFamilyRequest {
  id                   String        @id @default(cuid())
  familyId             String
  status               RequestStatus @default(ACTIVE)
  requestText          String
  notes                String?
  linkedScripture      String?
  linkedJournalEntryId String?       // Phase 4: Links to journalEntry.id
  dateAdded            DateTime      @default(now())
  dateUpdated          DateTime      @updatedAt
  lastPrayedAt         DateTime?
  answeredAt           DateTime?

  // Relations
  family               prayerFamily  @relation(fields: [familyId], references: [id])
  linkedEntry          journalEntry? @relation("FamilyRequestSource", fields: [linkedJournalEntryId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([linkedJournalEntryId])
}

model prayerPersonalRequest {
  id                   String            @id @default(cuid())
  spaceId              String
  status               RequestStatus     @default(ACTIVE)
  requestText          String
  notes                String?
  linkedScripture      String?
  requesterMemberId    String?
  linkedJournalEntryId String?           // Phase 4: Links to journalEntry.id
  subjectMemberId      String?           // Phase 4: Child member for kids-related requests
  dateAdded            DateTime          @default(now())
  dateUpdated          DateTime          @updatedAt
  lastPrayedAt         DateTime?
  answeredAt           DateTime?

  // Relations
  space                prayerFamilySpace @relation(fields: [spaceId], references: [id])
  linkedEntry          journalEntry?     @relation("PersonalRequestSource", fields: [linkedJournalEntryId], references: [id], onDelete: SetNull)

  @@index([spaceId])
  @@index([linkedJournalEntryId])
  @@index([subjectMemberId])
}

model prayerJournalEntry {
  id        String            @id @default(cuid())
  spaceId   String
  entryDate DateTime          @default(now())
  entryText String
  tags      String[]
  space     prayerFamilySpace @relation(fields: [spaceId], references: [id])
}

// ==========================================
// Journal v1 (Personal Journal) - Phase 2
// ==========================================

model journalEntry {
  id              String            @id @default(cuid())
  spaceId         String?           // Links to prayerFamilySpace (household)
  authorProfileId String            // Links to userProfile.id
  entryDate       DateTime          @default(now())
  entryText       String
  entryType       JournalEntryType  @default(PERSONAL)
  category        LogCategory?      // Only used for DISCIPLESHIP entries (Phase 3)
  subjectMemberId String?           // Child member ID for DISCIPLESHIP entries
  gospelConnection String?          // How the parent pointed the child to Jesus (Phase 3)
  tags            String[]          // Flat array for quick filtering
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  space            prayerFamilySpace?      @relation(fields: [spaceId], references: [id])
  aiOutput         journalEntryAI?
  personalRequests prayerPersonalRequest[] @relation("PersonalRequestSource")
  familyRequests   prayerFamilyRequest[]   @relation("FamilyRequestSource")

  @@index([spaceId])
  @@index([authorProfileId])
  @@index([subjectMemberId])
  @@index([entryType])
}

model journalEntryAI {
  id        String       @id @default(cuid())
  entryId   String       @unique
  call1     Json         // Pastoral Reflection output
  call2     Json?        // Tags + Prayer Suggestions output (nullable until processed)
  modelInfo Json         // { model: string, version: string, promptVersion: string }
  createdAt DateTime     @default(now())

  // Relations
  entry     journalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model chatHistory {
  id                String        @id @default(cuid())
  userId            String
  creationRequestId String?
  conversationName  String
  createdAt         DateTime      @default(now())
  modifiedAt        DateTime      @updatedAt
  category          String
  issue_type        String
  subcategory       String
  denomination      String        @default("reformed-baptist")
  messages          chatMessage[] @relation("ChatMessages")

  @@unique([userId, creationRequestId])
}

model chatMessage {
  id        String      @id @default(cuid())
  chatId    String
  requestId String?
  sender    String
  content   String
  timestamp DateTime    @default(now())
  chat      chatHistory @relation("ChatMessages", fields: [chatId], references: [id])

  @@index([chatId, requestId])
}

model parrotDevotionals {
  id              String   @id @default(cuid())
  devotional_id   String   @unique
  bible_verse     String
  title           String
  devotional_text String
  createdAt       DateTime @default(now())
}

model MemoryStore {
  namespace_path String
  key            String
  value          Json
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expires_at     DateTime? @db.Timestamptz(6)

  @@id([namespace_path, key])
  @@index([namespace_path], map: "idx_store_namespace_path")
  @@index([value], map: "idx_store_value_gin", type: Gin)
  @@map("store")
}

model church {
  id                     String              @id @default(cuid())
  name                   String
  website                String              @unique
  phone                  String?
  email                  String?
  denominationLabel      String?
  denominationConfidence Float?
  denominationSignals    String[]
  confessionAdopted      Boolean             @default(false)
  confessionName         String?
  confessionSourceUrl    String?
  bestBeliefsUrl         String?
  bestConfessionUrl      String?
  bestAboutUrl           String?
  bestLeadershipUrl      String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  addresses              churchAddress[]
  evaluations            churchEvaluation[]
  serviceTimes           churchServiceTime[]
}

model churchAddress {
  id        String   @id @default(cuid())
  churchId  String
  street1   String?
  street2   String?
  city      String?
  state     String?
  postCode  String?
  latitude  Float?
  longitude Float?
  sourceUrl String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  church    church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model churchServiceTime {
  id        String   @id @default(cuid())
  churchId  String
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  church    church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model churchEvaluation {
  id                         String                 @id @default(cuid())
  churchId                   String
  rawEvaluation              Json
  badges                     String[]
  secondary                  Json?
  tertiary                   Json?
  coreOnSiteCount            Int
  coreTotalCount             Int
  coverageRatio              Float
  status                     ChurchEvaluationStatus
  coreTrinity                CoreDoctrineStatus
  coreGospel                 CoreDoctrineStatus
  coreJustificationByFaith   CoreDoctrineStatus
  coreChristDeityHumanity    CoreDoctrineStatus
  coreScriptureAuthority     CoreDoctrineStatus
  coreIncarnationVirginBirth CoreDoctrineStatus
  coreAtonementNecessary     CoreDoctrineStatus
  coreResurrectionOfJesus    CoreDoctrineStatus
  coreReturnAndJudgment      CoreDoctrineStatus
  coreCharacterOfGod         CoreDoctrineStatus
  createdAt                  DateTime               @default(now())
  church                     church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model store_migrations {
  v Int @id
}

// ==========================================
// Sermon Evaluation
// ==========================================

model sermonPreacher {
  id             String             @id @default(cuid())
  ownerId        String
  displayName    String
  normalizedName String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  evaluations    sermonEvaluation[]

  @@unique([ownerId, normalizedName])
  @@index([ownerId])
}

model sermonAudioFingerprint {
  id                 String                       @id @default(cuid())
  ownerId            String
  sha256             String                       @db.Char(64)
  verificationState  SermonFingerprintState       @default(PROVISIONAL)
  runCreditsLimit    Int                          @default(9)
  runCreditsReserved Int                          @default(0)
  runCreditsConsumed Int                          @default(0)
  firstSeenAt        DateTime                     @default(now())
  lastSeenAt         DateTime                     @default(now())
  verifiedAt         DateTime?
  audioAsset         sermonAudioAsset?
  evaluations        sermonEvaluation[]
  creditReservations sermonRunCreditReservation[]
  uploadReservations sermonUploadReservation[]

  @@unique([ownerId, sha256])
  @@index([ownerId, verificationState])
}

model sermonUploadReservation {
  id                   String                       @id @default(cuid())
  ownerId              String
  claimedSha256        String                       @db.Char(64)
  originalFilename     String
  mimeType             String
  byteSize             Int
  requestedPreset      SermonEvaluationPreset
  requestedRuns        Int
  appwriteBucketId     String
  appwriteFileId       String                       @unique
  state                SermonUploadReservationState @default(PREPARED)
  expiresAt            DateTime
  fingerprintId        String?
  reattachEvaluationId String?
  finalizedAt          DateTime?
  consumedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  fingerprint          sermonAudioFingerprint?      @relation(fields: [fingerprintId], references: [id], onDelete: SetNull)
  reattachEvaluation   sermonEvaluation?            @relation("SermonUploadReattachTarget", fields: [reattachEvaluationId], references: [id], onDelete: SetNull)

  @@index([ownerId, claimedSha256])
  @@index([state, expiresAt])
  @@index([fingerprintId])
}

model sermonAudioAsset {
  id                String                 @id @default(cuid())
  fingerprintId     String                 @unique
  appwriteBucketId  String?
  appwriteFileId    String?                @unique
  originalFilename  String
  mimeType          String
  byteSize          Int
  durationSeconds   Float?
  referenceCount    Int                    @default(0)
  verificationState SermonAudioAssetState  @default(PENDING)
  verifiedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  fingerprint       sermonAudioFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Restrict)
  evaluations       sermonEvaluation[]

  @@index([verificationState])
  @@index([deletedAt])
}

model sermonEvaluation {
  id                        String                      @id @default(cuid())
  ownerId                   String
  preacherId                String
  fingerprintId             String
  audioAssetId              String?
  sourceEvaluationId        String?
  title                     String
  preachedOn                DateTime                    @db.Date
  preset                    SermonEvaluationPreset
  requestedRuns             Int
  completedRuns             Int                         @default(0)
  retryWave                 Int                         @default(0)
  status                    SermonEvaluationStatus      @default(QUEUED)
  version                   Int                         @default(0)
  attemptDeadlineAt         DateTime?
  cancelRequestedAt         DateTime?
  canceledAt                DateTime?
  durationAdjustmentEnabled Boolean                     @default(false)
  durationPolicyUpdatedAt   DateTime?
  durationPolicyUpdatedBy   String?
  overallImpactBase         Float?
  calculatedDurationPenalty Float?
  overallImpactAdjusted     Float?
  result                    Json?
  provenance                Json?
  warningCodes              String[]                    @default([])
  errorCode                 String?
  errorMessage              String?
  startedAt                 DateTime?
  completedAt               DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  preacher                  sermonPreacher              @relation(fields: [preacherId], references: [id], onDelete: Restrict)
  fingerprint               sermonAudioFingerprint      @relation(fields: [fingerprintId], references: [id], onDelete: Restrict)
  audioAsset                sermonAudioAsset?           @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)
  sourceEvaluation          sermonEvaluation?           @relation("SermonEvaluationLineage", fields: [sourceEvaluationId], references: [id], onDelete: SetNull)
  reevaluations             sermonEvaluation[]          @relation("SermonEvaluationLineage")
  uploadReattachments       sermonUploadReservation[]   @relation("SermonUploadReattachTarget")
  scoringRuns               sermonScoringRun[]
  scoringAttempts           sermonScoringAttempt[]
  evaluationAttempts        sermonEvaluationAttempt[]
  creditReservation         sermonRunCreditReservation?
  adminAuditEvents          sermonAdminAuditEvent[]
  workerLeases              sermonWorkerLease[]
  reportArtifacts           sermonReportArtifact[]

  @@index([ownerId, status])
  @@index([ownerId, preachedOn])
  @@index([ownerId, fingerprintId])
  @@index([fingerprintId, createdAt])
  @@index([preacherId, preachedOn])
  @@index([status, createdAt])
  @@index([status, durationPolicyUpdatedAt])
  @@index([ownerId, durationAdjustmentEnabled, preachedOn])
}

model sermonScoringRun {
  id           String                 @id @default(cuid())
  evaluationId String
  ordinal      Int
  status       SermonScoringRunStatus @default(PENDING)
  finalSeed    Int?
  rawScore     Json?
  confidence   Float?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  evaluation   sermonEvaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  attempts     sermonScoringAttempt[]

  @@unique([evaluationId, ordinal])
  @@index([evaluationId, status])
}

model sermonScoringAttempt {
  id                   String                     @id @default(cuid())
  evaluationId         String
  scoringRunId         String
  attemptNumber        Int
  seed                 Int
  status               SermonScoringAttemptStatus @default(PENDING)
  providerResponseId   String?
  providerModelVersion String?
  structuredResult     Json?
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  evaluation           sermonEvaluation           @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  scoringRun           sermonScoringRun           @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)

  @@unique([scoringRunId, attemptNumber])
  @@unique([evaluationId, seed])
  @@index([evaluationId, status])
}

model sermonEvaluationAttempt {
  id                  String                          @id @default(cuid())
  evaluationId        String
  attemptNumber       Int
  startedAt           DateTime?
  deadlineAt          DateTime
  endedAt             DateTime?
  appwriteExecutionId String?
  resumeReason        String?
  terminalOutcome     SermonEvaluationAttemptOutcome?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  evaluation          sermonEvaluation                @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  workerLeases        sermonWorkerLease[]

  @@unique([evaluationId, attemptNumber])
  @@index([evaluationId, deadlineAt])
  @@index([appwriteExecutionId])
}

model sermonRunCreditReservation {
  id               String                          @id @default(cuid())
  fingerprintId    String
  evaluationId     String                          @unique
  requestedCredits Int
  consumedCredits  Int                             @default(0)
  preset           SermonEvaluationPreset
  state            SermonRunCreditReservationState @default(RESERVED)
  actorId          String
  reservedAt       DateTime                        @default(now())
  consumedAt       DateTime?
  releasedAt       DateTime?
  releaseReason    String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  fingerprint      sermonAudioFingerprint          @relation(fields: [fingerprintId], references: [id], onDelete: Restrict)
  evaluation       sermonEvaluation                @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@index([actorId, reservedAt])
  @@index([fingerprintId, state])
}

model sermonAdminAuditEvent {
  id                String            @id @default(cuid())
  actorId           String
  evaluationId      String?
  ownerId           String?
  action            String
  requestedRunCount Int?
  reasonCode        String
  metadata          Json?
  createdAt         DateTime          @default(now())
  evaluation        sermonEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([actorId, action, createdAt])
  @@index([evaluationId, createdAt])
}

model sermonWorkerLease {
  slotId              Int                       @id
  leaseOwner          String?
  evaluationId        String?
  evaluationAttemptId String?
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  evaluation          sermonEvaluation?         @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  evaluationAttempt   sermonEvaluationAttempt?  @relation(fields: [evaluationAttemptId], references: [id], onDelete: Restrict)

  @@index([leaseExpiresAt])
  @@index([evaluationId])
  @@index([evaluationAttemptId])
}

model sermonReportArtifact {
  id            String             @id @default(cuid())
  evaluationId  String
  format        SermonReportFormat
  content       Bytes
  checksum      String             @db.Char(64)
  reportVersion Int
  createdAt     DateTime           @default(now())
  evaluation    sermonEvaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, format, reportVersion])
  @@index([evaluationId, createdAt])
}

enum MemberRole {
  OWNER
  MEMBER
}

enum RequestStatus {
  ACTIVE
  ANSWERED
  ARCHIVED
}

enum CoreDoctrineStatus {
  TRUE
  FALSE
  UNKNOWN
}

enum ChurchEvaluationStatus {
  RECOMMENDED
  BIBLICALLY_SOUND_WITH_DIFFERENCES
  LIMITED_INFORMATION
  NOT_ENDORSED
}

// ==========================================
// Journal v1 Enums - Phase 2
// ==========================================

enum JournalEntryType {
  PERSONAL      // Personal journal entry
  DISCIPLESHIP  // Kids discipleship log (Phase 3)
}

enum LogCategory {
  NURTURE     // Celebrating obedience, catching them doing good (Eph 6:4)
  ADMONITION  // Correcting disobedience, redirecting the heart (Eph 6:4)
}

enum SermonFingerprintState {
  PROVISIONAL
  VERIFIED
  REJECTED
}

enum SermonUploadReservationState {
  PREPARED
  FINALIZED
  CONSUMED
  EXPIRED
  CANCELED
}

enum SermonAudioAssetState {
  PENDING
  VERIFIED
  REJECTED
  DELETED
}

enum SermonEvaluationPreset {
  STANDARD
  HIGH_CONFIDENCE
  CUSTOM
}

enum SermonEvaluationStatus {
  QUEUED
  PREPARING_AUDIO
  EXTRACTING
  SCORING
  HARMONIZING
  AGGREGATING
  SUMMARIZING
  COMPLETE
  COMPLETE_WITH_WARNINGS
  FAILED
  TIMED_OUT
  CANCELED
}

enum SermonScoringRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum SermonScoringAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELED
}

enum SermonEvaluationAttemptOutcome {
  COMPLETE
  COMPLETE_WITH_WARNINGS
  FAILED
  TIMED_OUT
  CANCELED
}

enum SermonRunCreditReservationState {
  RESERVED
  CONSUMED
  RELEASED
}

enum SermonReportFormat {
  MARKDOWN
  JSON
  CSV
}

// ==========================================
// Kids Discipleship v1 (Heritage Journal) - Phase 3
// ==========================================

enum CompetencyType {
  PROFESSIONAL  // Career/work skills
  PERSONAL      // Life/home skills
}

model discipleshipAnnualPlan {
  id                  String         @id @default(cuid())
  memberId            String         // Child member (prayerMember.id)
  year                Int            // e.g., 2026

  // Four Elements
  characterGoal       String
  characterScripture  String?
  characterAction     String?

  competencyGoal      String
  competencyScripture String?
  competencyAction    String?
  competencyType      CompetencyType @default(PERSONAL)

  blessingsPlan       String?
  consequencesPlan    String?
  themeVerse          String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relation
  member              prayerMember   @relation("ChildAnnualPlans", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, year])
  @@index([memberId])
}

model discipleshipMonthlyVision {
  id              String       @id @default(cuid())
  memberId        String       // Child member (prayerMember.id)
  yearMonth       String       // Format: "YYYY-MM" (e.g., "2026-01")

  memoryVerse     String?
  characterFocus  String?
  competencyFocus String?
  emphasize       String?      // "What we will emphasize"
  watchFor        String?      // "What we will watch for"
  encourage       String?      // "How we will encourage" (blessings)
  correct         String?      // "How we will correct" (consequences)
  reviewNotes     String?      // Monthly review: "What to adjust next month"

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relation
  member          prayerMember @relation("ChildMonthlyVisions", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, yearMonth])
  @@index([memberId])
}
