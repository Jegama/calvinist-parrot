# Appwrite Function environment
# These variables belong to the deployed Python worker, not the root Next.js app.
# Appwrite injects APPWRITE_FUNCTION_API_ENDPOINT, APPWRITE_FUNCTION_PROJECT_ID,
# and APPWRITE_FUNCTION_API_KEY for each execution.

SERMON_RUNTIME=appwrite

# Dedicated least-privileged pooled Neon connection with sslmode=require.
SERMON_DATABASE_URL=

# Private Appwrite Storage bucket in the same project as the Function.
SERMON_AUDIO_BUCKET_ID=

# Worker-only model credentials and execution limits.
GEMINI_API_KEY=
SERMON_GEMINI_MODEL=gemini-3.6-flash
SERMON_SOFT_DEADLINE_SECONDS=840
SERMON_MAX_PARALLEL_SCORING_RUNS=9
